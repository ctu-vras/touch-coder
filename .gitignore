# Ignore Python cache files
__pycache__/
*.py[cod]
*$py.class
# Ignore distribution/build directories
build/
dist/

# Ignore flagged folder (if not needed in the repo)
flagged/

# Ignore videos/ contents (large binaries kept locally only)
# Exception: cat3.mp4 is the in-repo sample used for quick smoke testing.
/videos/**
!/videos/cat3.mp4

# Ignore data/ (labeling output) contents but keep the folder in the repo.
# Anchored with a leading slash so it cannot swallow scripts/bench/data/ etc.
/data/**
!/data/.gitkeep

# Pre-rename output root. Kept ignored so a not-yet-migrated working copy never
# offers real research data for commit; delete this rule once no local
# Labeled_data/ trees are left (migration_service moves them into data/).
/Labeled_data/**

# Ignore local environments and packaged executables

*.env
*.exe

# Ignore benchmark output data (extracted frames)
scripts/bench/data/

# Ignore pytest cache
.pytest_cache/

# Ignore log files
*.log

# Ignore hidden system files
.DS_Store
Thumbs.db

# Ignore virtual environments
.venv/
venv/
.env/
TinyTouch_env/

# Ignore generated sorted frames
/data/*/sorted_frames/
/data/*/sorted_frames/**

# Ignore editor-specific project metadata
/.idea/

# Keep local assistant and internal working files out of the public repository
/AGENTS.md
/CLAUDE.md
/.agents/
/.claude/
/.mcp.json
/TODO.md
/DONE.md
/docs/books/
/docs/plans/
/docs/reviews/
/docs/dev/HANDOFF.md

# Local reference assets that are not part of the application or documentation
/assets/icons_unused/
/assets/tutorial.mp4
/surprise.txt
